# Server-only. Use separate roles/databases in production; never use local trust authentication remotely.
DATABASE_URL=postgresql://pettah_dev@127.0.0.1:55432/pettah_dev
# Integration and E2E tests require a separate LOCAL database ending in _test.
TEST_DATABASE_URL=postgresql://pettah_dev@127.0.0.1:55432/pettah_test
# Optional; defaults to http://localhost:3000. Set your real HTTPS origin on deployment.
SITE_URL=http://localhost:3000
# Map tiles: local dev/localhost uses OSM Standard with attribution and native HTTP caching.
# Public deployments require CARTO and a client-visible basemap-only key; never put server credentials here.
# Obtain a key under CARTO Basemaps terms and restrict it to the intended site origins where supported.
# MAP_TILE_PROVIDER=carto
# NEXT_PUBLIC_CARTO_BASEMAP_KEY=your-public-basemap-key
